# Sao chép thành .env.local khi chạy thử máy nhà (vercel dev). Trên Vercel: Settings → Environment Variables.
# DATABASE_URL được Vercel tự thêm khi kết nối Neon (Storage → Create Database → Neon).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# (Tùy chọn) Khóa ESP32 dùng để ghi dữ liệu. BỎ TRỐNG / không tạo = API mở, không cần khóa
DEVICE_KEY=

# (Tùy chọn) Không đặt thì cron vẫn chạy (API nhận diện Vercel Cron qua user-agent)
CRON_SECRET=

# Số ngày giữ dữ liệu telemetry (events giữ gấp 3)
RETENTION_DAYS=30

# MQTT cho trình duyệt (trả về qua /api/config – KHÔNG đưa tài khoản ESP32 vào đây)
MQTT_WS_URL=wss://broker.hivemq.com:8884/mqtt
MQTT_TOPIC_BASE=smartaquarium_node2026
MQTT_WEB_USERNAME=
MQTT_WEB_PASSWORD=
